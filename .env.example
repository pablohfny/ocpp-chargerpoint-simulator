# Optional: everything works against a local stack without a .env. Copy to
# .env only to override. .env is gitignored and loaded by the Makefile.

# OCPP server the simulator connects to (also settable with --serverAddr).
# Defaults to the local Backend/server; the values below are the defaults.
SERVER_ADDR=localhost:3001
CLIENT_ID=virtual
HTTP_PORT=8080

# OCPP server used by `make run-dev`
DEV_SERVER_ADDR=ocpp.example.com

# HTTP basic auth for the web UI and control APIs; leave SIM_USER empty to disable
SIM_USER=
SIM_PASS=

# OCPI partner simulator
# Defaults to the local Backend/ocpi-service
OCPI_SIM_BASE_URL=http://localhost:3030
OCPI_SIM_PUBLIC_URL=http://localhost:8080
OCPI_SIM_DATA=./data/ocpi-partners.json
SIM_SETTINGS_FILE=./data/settings.json
OCPI_SIM_DEFAULT_LOCATION=
OCPI_SIM_DEFAULT_EVSE=
OCPI_SIM_DEFAULT_CONNECTOR=1

# Virtual EV battery size used for the battery percentage
BATTERY_CAPACITY_KWH=60
